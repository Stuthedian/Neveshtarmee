<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp2"
             x:Class="MauiApp2.MainPage">
    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ScrollView Grid.Row="0" Grid.Column="0" Orientation="Both">
            <controls:RecordCollection x:Name="MainRecordCollection"/>
        </ScrollView>
        <ScrollView Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="1">
                <Button
                     x:Name="LoadBtn"
                     Text="Load file" 
                     Clicked="LoadBut_Clicked"/>
                <Button x:Name="saveBut" Text="Save and upload file" Clicked="saveBut_Clicked" IsEnabled="False"/>
                <Button x:Name="tabBut" Text="tabulate" Clicked="tabBut_Clicked"/>
                <Button x:Name="unTabBut" Text="untabulate" Clicked="unTabBut_Clicked"/>
                <Button x:Name="unColBut" Text="(un)Collapse" Clicked="unColBut_Clicked"/>
                <Button x:Name="backupBut" Text="Backup" Clicked="backupBut_Clicked"/>
                <Button x:Name="authBut" Text="auth" Clicked="authBut_Clicked"/>
                <Button x:Name="resetAuthBut" Text="reset auth" Clicked="resetAuthBut_Clicked"/>
            </HorizontalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
